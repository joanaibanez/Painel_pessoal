# Copie para .env apenas para execução local. NUNCA versione o .env.
# Use a string de conexão do pooler do Supabase (Project Settings → Database).
SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<senha>@aws-0-us-east-2.pooler.supabase.com:6543/postgres

# Opcional
# RETENCAO_DIAS=180
# JANELA_HORAS=30
